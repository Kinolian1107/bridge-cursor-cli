# cursor-bridge configuration
# Copy this to .env and adjust as needed
# (.env is loaded by cursor-bridge.mjs itself — works on Linux/macOS/Windows)

# Port for the bridge proxy server
BRIDGE_PORT=18790

# Cursor CLI model to use (run: cursor-agent --list-models for the live list)
# "auto" lets Cursor pick the best model and survives Cursor's frequent renames.
# Popular choices (as of cursor-agent 2026.06):
#   auto                           — Cursor picks (recommended default)
#   claude-fable-5-thinking-medium — Claude Fable 5 with Thinking
#   claude-opus-4-8-thinking-high  — Claude Opus 4.8 with Thinking
#   gpt-5.5-high                   — GPT-5.5 High
#   gpt-5.3-codex-high             — GPT-5.3 Codex High (best for tool calling)
#   gemini-3.1-pro                 — Gemini 3.1 Pro
#   composer-2.5                   — Cursor Composer 2.5 (fast)
CURSOR_MODEL=auto

# Path to cursor-agent binary or cursor wrapper
# Linux/macOS:
# CURSOR_BIN=/home/you/.local/bin/cursor-agent
# CURSOR_BIN=cursor
# Windows (native install: irm 'https://cursor.com/install?win32=true' | iex):
# CURSOR_BIN=C:\Users\you\.local\bin\cursor-agent.exe

# Workspace path for cursor agent
# CURSOR_WORKSPACE=/home/you/.cursor-bridge/workspace

# Agent mode: '' (full agent), 'ask' (read-only Q&A), 'plan' (read-only planning)
# CURSOR_MODE=ask

# Cursor authentication (alternative to `cursor agent login`)
# One of these is required if not already logged in via the CLI
# CURSOR_API_KEY=your-api-key-here
# CURSOR_AUTH_TOKEN=your-auth-token-here

# Use git worktree isolation (edits made in a temporary worktree under ~/.cursor/worktrees)
# CURSOR_WORKTREE=true

# Request timeout in milliseconds (default: 5 minutes)
# BRIDGE_TIMEOUT_MS=300000

# Optional bearer auth (v2.2). When set, every endpoint except /health requires
#   Authorization: Bearer <key>   (OpenAI SDK style), or
#   x-api-key: <key>              (Anthropic SDK style)
# Leave unset for localhost-only use; set it before exposing the bridge on a
# LAN / Tailscale network. Generate one with: openssl rand -hex 32
# BRIDGE_API_KEY=

# Model allowlist file (default: <project>/models.json).
# Manage it with: node select-models.mjs
# BRIDGE_MODELS_FILE=/path/to/models.json
